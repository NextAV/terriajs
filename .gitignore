# Update .prettierignore whenever this file changes
docs/
node_modules/
# ...and the SYMLINK form: a trailing slash matches a directory only, so a
# worktree's `node_modules -> /abs/path` symlink was NOT ignored and got
# committed (caught in review of #48). Both forms are ignored now.
node_modules
.idea/
build/
error.log
output.log
npm-debug.log
.DS_Store
terria.lib.js
terriajs-server.log
terriajs.pid
/wwwroot/doc/
/wwwroot/schema/
/wwwroot/user-guide/
/coverage/
package-lock.json
*.swp
dist
.history/
ts-out/

# Catalog index generation files
catalog-index*.json
